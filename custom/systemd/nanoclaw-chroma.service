[Unit]
Description=NanoClaw ChromaDB Vector Store
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/john/git/nanoclaw
ExecStart=/snap/bin/docker compose -f docker-compose.chroma.yml up -d
ExecStop=/snap/bin/docker compose -f docker-compose.chroma.yml down
Environment=HOME=/home/john
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/john/.local/bin:/snap/bin

[Install]
WantedBy=default.target
